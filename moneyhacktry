
-- Admin Money Panel | UI Demo
-- StarterPlayer > StarterPlayerScripts > LocalScript
-- Nur lokale Vorschau: keine serverseitige Geldänderung!

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local ADMIN_USER_IDS = {
    [123456789] = true, -- Durch deine Roblox-User-ID ersetzen
}

if not ADMIN_USER_IDS[player.UserId] then
    return
end

local gui = Instance.new("ScreenGui")
gui.Name = "AdminMoneyPanel"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(330, 220)
frame.Position = UDim2.new(0.5, -165, 0.5, -110)
frame.BackgroundColor3 = Color3.fromRGB(25, 28, 39)
frame.BorderSizePixel = 0
frame.Parent = gui

Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

local function makeLabel(text, y, height, size)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -24, 0, height)
    label.Position = UDim2.fromOffset(12, y)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = size
    label.Font = Enum.Font.GothamBold
    label.Parent = frame
    return label
end

makeLabel("ADMIN MONEY PANEL", 12, 35, 20)

local moneyLabel = makeLabel("Money: wird gesucht ...", 52, 30, 16)
local status = makeLabel("Lokale UI-Demo", 177, 25, 12)

local button = Instance.new("TextButton")
button.Size = UDim2.new(1, -24, 0, 42)
button.Position = UDim2.fromOffset(12, 112)
button.BackgroundColor3 = Color3.fromRGB(35, 180, 110)
button.TextColor3 = Color3.new(1, 1, 1)
button.Text = "+1.000 MONEY"
button.TextSize = 16
button.Font = Enum.Font.GothamBold
button.Parent = frame

Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

local function findMoney()
    local stats = player:FindFirstChild("leaderstats")
    if not stats then
        return nil
    end

    for _, value in ipairs(stats:GetChildren()) do
        if (value:IsA("IntValue") or value:IsA("NumberValue"))
            and string.find(value.Name:lower(), "money")
            or value:IsA("IntValue") and string.find(value.Name:lower(), "cash")
            or value:IsA("IntValue") and string.find(value.Name:lower(), "coin") then
            if value:IsA("IntValue") or value:IsA("NumberValue") then
                return value
            end
        end
    end

    return nil
end

local money = findMoney()

local function refresh()
    money = findMoney()
    if money then
        moneyLabel.Text = money.Name .. ": " .. tostring(money.Value)
    else
        moneyLabel.Text = "Keine Money-Stat gefunden"
    end
end

button.Activated:Connect(function()
    money = findMoney()

    if not money then
        status.Text = "Keine passende Leaderstat gefunden."
        return
    end

    -- Lokale Änderung: wird nicht zuverlässig gespeichert
    -- und nicht vom Server als echte Währung akzeptiert.
    money.Value += 1000
    status.Text = "+1.000 lokal angezeigt"
    refresh()
end)

task.spawn(function()
    while gui.Parent do
        refresh()
        task.wait(1)
    end
end)
